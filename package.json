{
  "name": "kpi-tracker",
  "version": "1.0.0",
  "description": "Desktop KPI tracking application for managers and employees",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/VidorGurovich/KPI-Tracker#readme",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:preload\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js",
    "dev:main": "webpack --config webpack.main.config.js --watch",
    "dev:preload": "webpack --config webpack.preload.config.js --watch",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js",
    "build:preload": "webpack --config webpack.preload.config.js",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/init-db.ts",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VidorGurovich/KPI-Tracker.git"
  },
  "keywords": [
    "kpi",
    "performance",
    "tracking",
    "management",
    "electron",
    "desktop"
  ],
  "author": "Vidor Gurovich",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VidorGurovich/KPI-Tracker/issues"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.1",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.1.3",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.2",
    "ts-loader": "^9.5.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "chart.js": "^4.5.0",
    "electron": "^38.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "sqlite3": "^5.0.0"
  }
}
